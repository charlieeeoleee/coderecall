rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserRecord() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn() &&
        (
          getUserRecord().data.role == "admin" ||
          getUserRecord().data.role == "super_admin" ||
          getUserRecord().data.progress.role == "admin" ||
          getUserRecord().data.progress.role == "super_admin"
        );
    }

    function isSuperAdmin() {
      return isSignedIn() &&
        (
          getUserRecord().data.role == "super_admin" ||
          getUserRecord().data.progress.role == "super_admin"
        );
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /users/{userId} {
      allow create: if isOwner(userId);
      allow read: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin();
    }

    match /leaderboard_public/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId) || isAdmin();
    }

    match /accessRoles/{roleId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /pendingUsers/{pendingUserId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /feedbackNotes/{noteId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read, create: if isAdmin();
    }

    match /contactMessages/{messageId} {
      allow create: if isSignedIn()
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.assignedAdminUid is string
        && request.resource.data.status is string;

      allow read: if isOwner(resource.data.createdByUid)
        || isSuperAdmin()
        || (
          isAdmin()
          && (
            resource.data.assignedAdminUid == ""
            || resource.data.assignedAdminUid == request.auth.uid
          )
        );

      allow update: if isSuperAdmin()
        || (
          isAdmin()
          && (
            resource.data.assignedAdminUid == ""
            || resource.data.assignedAdminUid == request.auth.uid
          )
        );
    }
  }
}
