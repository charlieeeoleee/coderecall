rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrapSuperAdminEmail() {
      return isSignedIn()
        && request.auth.token.email == "charlesvrobeso@gmail.com";
    }

    function isBootstrapAdminEmail() {
      return isSignedIn()
        && (
          isBootstrapSuperAdminEmail() ||
          request.auth.token.email == "marvicdatulmansibang@gmail.com" ||
          request.auth.token.email == "biancadenisemedel@gmail.com" ||
          request.auth.token.email == "reinbarb27@gmail.com"
        );
    }

    function signedInUserDocExists() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function signedInUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasStoredAdminRole() {
      return signedInUserDocExists()
        && signedInUserData().get("status", "active") != "disabled"
        && (
          signedInUserData().get("role", "user") == "admin" ||
          signedInUserData().get("role", "user") == "super_admin" ||
          progressRole(signedInUserData()) == "admin" ||
          progressRole(signedInUserData()) == "super_admin"
        );
    }

    function hasStoredSuperAdminRole() {
      return signedInUserDocExists()
        && signedInUserData().get("status", "active") != "disabled"
        && (
          signedInUserData().get("role", "user") == "super_admin" ||
          progressRole(signedInUserData()) == "super_admin"
        );
    }

    function isAdmin() {
      return isSignedIn() &&
        (
          request.auth.token.get("role", "user") == "admin" ||
          request.auth.token.get("role", "user") == "super_admin" ||
          request.auth.token.get("admin", false) == true ||
          request.auth.token.get("super_admin", false) == true ||
          isBootstrapAdminEmail() ||
          hasStoredAdminRole()
        );
    }

    function isSuperAdmin() {
      return isSignedIn() &&
        (
          request.auth.token.get("role", "user") == "super_admin" ||
          request.auth.token.get("super_admin", false) == true ||
          isBootstrapSuperAdminEmail() ||
          hasStoredSuperAdminRole()
        );
    }

    function isMfaAdmin() {
      return isAdmin();
    }

    function isMfaSuperAdmin() {
      return isSuperAdmin();
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function progressRole(data) {
      return data.progress is map
        ? data.progress.get("role", "user")
        : "user";
    }

    function userAccessFieldsUnchanged() {
      return request.resource.data.get("role", "user") == resource.data.get("role", "user")
        && request.resource.data.get("status", "active") == resource.data.get("status", "active")
        && progressRole(request.resource.data) == progressRole(resource.data)
        && request.resource.data.get("firebaseMfaEnrolled", false) == resource.data.get("firebaseMfaEnrolled", false)
        && request.resource.data.get("firebaseMfaProvider", "") == resource.data.get("firebaseMfaProvider", "")
        && request.resource.data.get("firebaseMfaSource", "") == resource.data.get("firebaseMfaSource", "")
        && request.resource.data.get("firebaseMfaSyncedAt", null) == resource.data.get("firebaseMfaSyncedAt", null);
    }

    function userProtectedGamificationFieldsUnchanged() {
      return request.resource.data.get("xp", 0) == resource.data.get("xp", 0)
        && request.resource.data.get("xpWeekly", 0) == resource.data.get("xpWeekly", 0)
        && request.resource.data.get("xpChange", 0) == resource.data.get("xpChange", 0)
        && request.resource.data.get("lastWeeklyReset", "") == resource.data.get("lastWeeklyReset", "")
        && request.resource.data.get("progress", {}) == resource.data.get("progress", {})
        && request.resource.data.get("results", {}) == resource.data.get("results", {});
    }

    function userDocumentHasAllowedKeys(data) {
      return data.keys().hasOnly([
        "xp",
        "xpWeekly",
        "xpChange",
        "lastWeeklyReset",
        "name",
        "email",
        "photo",
        "provider",
        "createdAt",
        "updatedAt",
        "lastActiveDate",
        "streak",
        "role",
        "status",
        "progress",
        "results",
        "studyHistory",
        "retentionQueue",
        "wrongAnswerReview",
        "resumeActivity",
        "privacyConsent",
        "firebaseMfaEnrolled",
        "firebaseMfaProvider",
        "firebaseMfaSource",
        "firebaseMfaSyncedAt"
      ]);
    }

    function validOwnerUserCreate(userId) {
      return isOwner(userId)
        && userDocumentHasAllowedKeys(request.resource.data)
        && request.resource.data.get("xp", 0) == 0
        && request.resource.data.get("xpWeekly", 0) == 0
        && request.resource.data.get("xpChange", 0) == 0
        && request.resource.data.get("progress", {}) == {}
        && request.resource.data.get("results", {}) == {}
        && (!("role" in request.resource.data) || request.resource.data.role == "user")
        && (!("status" in request.resource.data) || request.resource.data.status == "active")
        && progressRole(request.resource.data) == "user";
    }

    function validOwnerUserUpdate(userId) {
      return isOwner(userId)
        && userDocumentHasAllowedKeys(request.resource.data)
        && userAccessFieldsUnchanged()
        && userProtectedGamificationFieldsUnchanged();
    }

    function validAdminUserUpdate() {
      return isMfaAdmin()
        && userDocumentHasAllowedKeys(request.resource.data)
        && userAccessFieldsUnchanged()
        && userProtectedGamificationFieldsUnchanged();
    }

    function appMfaProfileKeys() {
      return [
        "uid",
        "email",
        "role",
        "appMfaEnabled",
        "appMfaSource",
        "totpSecret",
        "backupCodeHashes",
        "backupCodesRemaining",
        "backupCodeUseCount",
        "totpEnabled",
        "firebaseMfaEnrolled",
        "firebaseMfaProvider",
        "firebaseMfaSource",
        "firebaseMfaSyncedAt",
        "enrolledAt",
        "lastVerificationMethod",
        "lastVerifiedAt",
        "createdAt",
        "updatedAt"
      ];
    }

    function validOwnerAppMfaSecurityProfileData(userId) {
      return isOwner(userId)
        && request.resource.data.keys().hasOnly(appMfaProfileKeys())
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.get("email", "")
        && request.resource.data.role in ["admin", "super_admin"]
        && isAdmin()
        && (request.resource.data.role != "super_admin" || isSuperAdmin())
        && request.resource.data.appMfaSource == "app_totp"
        && request.resource.data.backupCodeHashes is list
        && request.resource.data.backupCodesRemaining is int;
    }

    function validOwnerAppMfaSecurityProfileCreate(userId) {
      return validOwnerAppMfaSecurityProfileData(userId);
    }

    function validOwnerAppMfaSecurityProfileUpdate(userId) {
      return validOwnerAppMfaSecurityProfileData(userId);
    }

    function keepsContactTicketIdentity() {
      return request.resource.data.ticketId == resource.data.ticketId
        && request.resource.data.category == resource.data.category
        && request.resource.data.subject == resource.data.subject
        && request.resource.data.message == resource.data.message
        && request.resource.data.status == resource.data.status
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.createdByName == resource.data.createdByName
        && request.resource.data.createdByEmail == resource.data.createdByEmail
        && request.resource.data.createdByRole == resource.data.createdByRole
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function keepsContactAdminFields() {
      return request.resource.data.assignedAdminUid == resource.data.assignedAdminUid
        && request.resource.data.assignedAdminName == resource.data.assignedAdminName
        && request.resource.data.assignedAdminRole == resource.data.assignedAdminRole
        && request.resource.data.replyText == resource.data.replyText
        && request.resource.data.replyHistory == resource.data.replyHistory
        && request.resource.data.repliedAt == resource.data.repliedAt
        && request.resource.data.repliedByUid == resource.data.repliedByUid
        && request.resource.data.repliedByName == resource.data.repliedByName
        && request.resource.data.repliedByRole == resource.data.repliedByRole
        && request.resource.data.resolvedAt == resource.data.resolvedAt
        && request.resource.data.resolvedByUid == resource.data.resolvedByUid
        && request.resource.data.resolvedByName == resource.data.resolvedByName
        && request.resource.data.resolvedByRole == resource.data.resolvedByRole;
    }

    function existingConversationSize() {
      return resource.data.conversationHistory is list
        ? resource.data.conversationHistory.size()
        : 0;
    }

    function appendedLearnerConversationEntryIsSafe() {
      let nextSize = request.resource.data.conversationHistory.size();
      let entry = request.resource.data.conversationHistory[nextSize - 1];
      return entry.type == "learner"
        && entry.text is string
        && entry.text.size() > 0
        && entry.byUid == request.auth.uid
        && entry.byName is string
        && entry.byRole is string
        && entry.at is string;
    }

    function validLearnerContactFollowUp() {
      return isOwner(resource.data.createdByUid)
        && resource.data.status != "resolved"
        && keepsContactTicketIdentity()
        && keepsContactAdminFields()
        && request.resource.data.conversationHistory is list
        && request.resource.data.conversationHistory.size() > existingConversationSize()
        && request.resource.data.conversationHistory.size() <= existingConversationSize() + 1
        && appendedLearnerConversationEntryIsSafe();
    }

    function validClientSecurityAuditCreate() {
      return isSignedIn()
        && request.resource.data.keys().hasOnly([
          "action",
          "details",
          "metadata",
          "actorUid",
          "actorEmail",
          "createdAt"
        ])
        && request.resource.data.action in [
          "denied_admin_route",
          "denied_super_admin_route",
          "mfa_required_privileged_route",
          "mfa_enrollment_required"
        ]
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorEmail == request.auth.token.get("email", "")
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 500
        && (!("metadata" in request.resource.data) || request.resource.data.metadata is map)
        && request.resource.data.createdAt == request.time;
    }

    function publicLeaderboardKeys() {
      return [
        "name",
        "photo",
        "xp",
        "xpWeekly",
        "xpChange",
        "updatedAt"
      ];
    }

    function validPublicLeaderboardWrite(userId) {
      let owner = get(/databases/$(database)/documents/users/$(userId)).data;
      return isOwner(userId)
        && signedInUserDocExists()
        && request.resource.data.keys().hasOnly(publicLeaderboardKeys())
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.photo is string
        && request.resource.data.photo.size() <= 500
        && request.resource.data.xp is number
        && request.resource.data.xpWeekly is number
        && request.resource.data.xpChange is number
        && request.resource.data.xp >= 0
        && request.resource.data.xpWeekly >= 0
        && request.resource.data.xpChange >= 0
        && request.resource.data.xp == owner.get("xp", 0)
        && request.resource.data.xpWeekly == owner.get("xpWeekly", 0)
        && request.resource.data.xpChange == owner.get("xpChange", 0)
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() <= 40;
    }

    function contactMessageCreateKeys() {
      return [
        "ticketId",
        "category",
        "subject",
        "message",
        "status",
        "createdByUid",
        "createdByName",
        "createdByEmail",
        "createdByRole",
        "createdAt",
        "updatedAt",
        "assignedAdminUid",
        "assignedAdminName",
        "assignedAdminRole",
        "replyText",
        "replyHistory",
        "conversationHistory",
        "repliedAt",
        "repliedByUid",
        "repliedByName",
        "repliedByRole",
        "resolvedAt",
        "resolvedByUid",
        "resolvedByName",
        "resolvedByRole"
      ];
    }

    function validInitialContactConversationEntry() {
      return request.resource.data.conversationHistory is list
        && request.resource.data.conversationHistory.size() == 1
        && request.resource.data.conversationHistory[0].type == "learner"
        && request.resource.data.conversationHistory[0].text == request.resource.data.message
        && request.resource.data.conversationHistory[0].byUid == request.auth.uid
        && request.resource.data.conversationHistory[0].byName is string
        && request.resource.data.conversationHistory[0].byName.size() <= 120
        && request.resource.data.conversationHistory[0].byRole is string
        && request.resource.data.conversationHistory[0].byRole in ["user", "admin", "super_admin"]
        && request.resource.data.conversationHistory[0].at is string
        && request.resource.data.conversationHistory[0].at.size() <= 40;
    }

    function validContactMessageCreate() {
      return isSignedIn()
        && request.resource.data.keys().hasOnly(contactMessageCreateKeys())
        && request.resource.data.ticketId is string
        && request.resource.data.ticketId.matches("^TCK-[0-9]{9}$")
        && request.resource.data.category in [
          "concern",
          "privacy",
          "item_feedback",
          "feedback",
          "comment",
          "bug",
          "idea"
        ]
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.subject.size() <= 120
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 3000
        && request.resource.data.status == "open"
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdByName is string
        && request.resource.data.createdByName.size() <= 120
        && request.resource.data.createdByEmail == request.auth.token.get("email", "")
        && request.resource.data.createdByRole is string
        && request.resource.data.createdByRole in ["user", "admin", "super_admin"]
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.assignedAdminUid == ""
        && request.resource.data.assignedAdminName == ""
        && request.resource.data.assignedAdminRole == ""
        && request.resource.data.replyText == ""
        && request.resource.data.replyHistory is list
        && request.resource.data.replyHistory.size() == 0
        && validInitialContactConversationEntry()
        && request.resource.data.repliedAt == null
        && request.resource.data.repliedByUid == ""
        && request.resource.data.repliedByName == ""
        && request.resource.data.repliedByRole == ""
        && request.resource.data.resolvedAt == null
        && request.resource.data.resolvedByUid == ""
        && request.resource.data.resolvedByName == ""
        && request.resource.data.resolvedByRole == "";
    }

    function validClientErrorReportCreate() {
      return request.resource.data.keys().hasOnly([
          "event",
          "message",
          "source",
          "route",
          "userAgent",
          "createdAt"
        ])
        && request.resource.data.event in ["uncaught_error", "unhandled_rejection"]
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 240
        && request.resource.data.source is string
        && request.resource.data.source.size() <= 180
        && request.resource.data.route is string
        && request.resource.data.route.size() <= 180
        && request.resource.data.userAgent is string
        && request.resource.data.userAgent.size() <= 180
        && request.resource.data.createdAt == request.time;
    }

    match /users/{userId} {
      allow create: if validOwnerUserCreate(userId);
      allow read: if isOwner(userId) || isMfaAdmin();
      allow update: if validOwnerUserUpdate(userId) || validAdminUserUpdate() || isMfaSuperAdmin();
      allow delete: if isMfaSuperAdmin() && request.auth.uid != userId;
    }

    match /leaderboard_public/{userId} {
      allow read: if true;
      allow create, update: if validPublicLeaderboardWrite(userId) || isMfaAdmin();
      allow delete: if isMfaSuperAdmin() && request.auth.uid != userId;
    }

    match /accessRoles/{roleId} {
      allow get: if isSignedIn();
      allow list: if isMfaSuperAdmin();
      allow create, update, delete: if isMfaSuperAdmin();
    }

    match /securityProfiles/{userId} {
      allow read: if isOwner(userId) || isMfaSuperAdmin();
      allow create: if validOwnerAppMfaSecurityProfileCreate(userId);
      allow update: if validOwnerAppMfaSecurityProfileUpdate(userId);
      allow delete: if isMfaSuperAdmin() && request.auth.uid != userId;
    }

    match /pendingUsers/{pendingUserId} {
      allow read, create, update, delete: if isMfaSuperAdmin();
    }

    match /feedbackNotes/{noteId} {
      allow read, create, update, delete: if isMfaAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isMfaAdmin();
      allow create: if isMfaAdmin() || validClientSecurityAuditCreate();
    }

    match /contactMessages/{messageId} {
      allow create: if validContactMessageCreate();

      allow read: if isOwner(resource.data.createdByUid)
        || isMfaSuperAdmin()
        || (
          isMfaAdmin()
          && (
            resource.data.assignedAdminUid == ""
            || resource.data.assignedAdminUid == request.auth.uid
          )
        );

      allow update: if isMfaSuperAdmin()
        || (
          isMfaAdmin()
          && (
            resource.data.assignedAdminUid == ""
            || resource.data.assignedAdminUid == request.auth.uid
          )
        )
        || validLearnerContactFollowUp();
    }

    match /clientErrorReports/{reportId} {
      allow create: if validClientErrorReportCreate();
      allow read, update, delete: if isMfaAdmin();
    }
  }
}
