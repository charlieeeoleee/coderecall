# Required server-only Firebase Admin credentials.
# Configure real values in Vercel environment variables; never commit them here.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Public Firebase Web App configuration. Configure these separately for each
# Vercel environment. Preview must use a different project than Production.
CODE_RECALL_FIREBASE_API_KEY=
CODE_RECALL_FIREBASE_AUTH_DOMAIN=
CODE_RECALL_FIREBASE_PROJECT_ID=
CODE_RECALL_FIREBASE_STORAGE_BUCKET=
CODE_RECALL_FIREBASE_MESSAGING_SENDER_ID=
CODE_RECALL_FIREBASE_APP_ID=
CODE_RECALL_FIREBASE_APP_CHECK_SITE_KEY=

# Required in Vercel Production and Preview for build-time and Admin isolation checks.
# This is a public project identifier, not an Admin credential.
CODE_RECALL_PRODUCTION_FIREBASE_PROJECT_ID=
